cabal-version:      3.0
name:               trellis
version:            0.1.0.0
synopsis:           a comonadic terminal spreadsheet
author:             Gatlin Cheyenne Johnson
maintainer:         gatlin@niltag.net
category:           Data
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall -Wunused-top-binds

library
    import:           warnings
    hs-source-dirs:   src
    default-language: Haskell2010

    -- Peano/Lists/Nested/Sheet and CPS/Tubes/UI are vendored verbatim from
    -- an earlier project. Day is pulled from garden's Weeds.hs scratch
    -- pile, unused for now but useful later. [^1]
    exposed-modules:
        Trellis.UI,
        Trellis.Peano,
        Trellis.Lists,
        Trellis.Nested,
        Trellis.Sheet,
        Trellis.CPS,
        Trellis.Tubes,
        Trellis.Day

    build-depends:    base,
                      adjunctions,
                      attoparsec,
                      comonad,
                      containers,
                      distributive,
                      free,
                      monadIO,
                      profunctors,
                      termbox2-hs,
                      text,
                      time,
                      transformers

executable trellis
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -rtsopts

    -- SheetState/Render/Update/Formula/Parser/Keymap are the spreadsheet
    -- app itself, built on the library's reusable machinery but not
    -- reusable machinery themselves - so unlike src/Trellis, they live here.
    other-modules:    SheetState, Render, Update, Formula, Parser, Keymap

    build-depends:    base,
                      adjunctions,
                      attoparsec,
                      containers,
                      directory,
                      filepath,
                      termbox2-hs,
                      text,
                      time,
                      trellis

test-suite trellis-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    default-language: Haskell2010

    -- Reaches into app/ directly since SheetState/Formula/Parser/Update/
    -- Keymap aren't exposed library modules. Named Spec.hs, not Main.hs, to
    -- avoid colliding with app/Main.hs on this shared source-dir path. [^2]
    hs-source-dirs:   test, app
    other-modules:    SheetStateSpec, FormulaSpec, UpdateSpec,
                      SheetState, Formula, Parser, Update, Keymap

    build-depends:    base,
                      adjunctions,
                      attoparsec,
                      containers,
                      directory,
                      filepath,
                      termbox2-hs,
                      text,
                      time,
                      trellis,
                      tasty,
                      tasty-hunit,
                      tasty-quickcheck,
                      QuickCheck

-- [^1]:
-- Peano/Lists/Nested/Sheet are the source of truth for the Sheets
-- machinery, vendored verbatim from an earlier project. CPS/Tubes/UI are
-- that project's terminal activity loop, vendored so Trellis can grow its
-- own interactive front end the same way. Day is exactly the tool for
-- composing differently-typed sibling widgets (e.g. a viewport plus an
-- edit buffer), once that's needed.

-- [^2]:
-- SheetState/Formula/Parser/Update/Keymap aren't exposed library modules
-- (see the executable stanza above), so this is the only way a separate
-- test-suite component can compile against them without either moving
-- them back into the library or adding a third internal-library
-- component just to share code between two components - overkill for a
-- project this size.
