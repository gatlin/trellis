cabal-version:      3.0
name:               trellis
version:            0.1.6.0
synopsis:           a comonadic terminal spreadsheet
author:             Gatlin Cheyenne Johnson
maintainer:         gatlin@niltag.net
category:           Data
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall -Wunused-top-binds -split-sections

library
    import:           warnings
    default-language: Haskell2010

    -- Trellis.UI.Screen is the one part of the library that differs per
    -- target: termbox2-backed natively, canvas/DOM under wasm (Phase 2 of
    -- /home/gcj/.claude/plans/prancy-enchanting-star.md - a stub for now)
    -- - same module name, swapped hs-source-dirs, same trick already used
    -- for Trellis.Orc below.
    if os(wasi)
        hs-source-dirs: src, src-wasi
    else
        hs-source-dirs: src, src-native

    -- Peano/Lists/Nested/Sheet and CPS/Tubes/UI are vendored verbatim from
    -- an earlier project. Day is pulled from garden's Weeds.hs scratch
    -- pile, unused for now but useful later. HIO/Orc are garden's
    -- orchestration EDSL, letting a cell come from or publish to a live
    -- source. [^1]
    exposed-modules:
        Trellis.UI,
        Trellis.UI.Backend,
        Trellis.UI.Core,
        Trellis.UI.Screen,
        Trellis.Peano,
        Trellis.Lists,
        Trellis.Nested,
        Trellis.Sheet,
        Trellis.CPS,
        Trellis.Tubes,
        Trellis.Day,
        Trellis.HIO,
        Trellis.Orc

    -- Trellis.HIO's HasFork instance needs this to pick its mask-based
    -- fork implementation over one using block/unblock, long removed
    -- from base.
    cpp-options:      -D__GHC_BLOCK_DEPRECATED__

    build-depends:    base,
                      adjunctions,
                      attoparsec,
                      comonad,
                      containers,
                      deepseq,
                      distributive,
                      free,
                      monadIO,
                      profunctors,
                      text,
                      time,
                      transformers

    if os(wasi)
        build-depends: ghc-experimental
    else
        build-depends: termbox2-hs

executable trellis
    import:           warnings
    main-is:          Main.hs
    default-language: Haskell2010

    -- Main/Live.In/Live.Out differ per target the same way the library's
    -- own Trellis.UI.Screen/Trellis.Orc do - same module names, swapped
    -- hs-source-dirs. Everything else (SheetState/Render/Update/Formula/
    -- Parser/Keymap/Cli/SheetFile) stays shared, unconditionally in app/.
    if os(wasi)
        hs-source-dirs: app, app-wasi
    else
        hs-source-dirs: app, app-native

    if os(wasi)
        -- A wasm32-wasi build with any JSFFI at all must link as a
        -- "reactor" module (a bit like a shared library: internal
        -- functions plus explicit user-defined entry points, callable
        -- repeatedly after one init) rather than the default "command"
        -- module (a single _start, run once, exit) - see
        -- ~/.ghc-wasm/wasm32-wasi-ghc/doc/html/users_guide/_sources/wasm.rst.txt.
        -- Every `foreign export javascript` name needs an explicit
        -- --export= too, or the linker's dead-code elimination drops it.
        -- init_shim.c's hs_init_ghc() call is required in this mode -
        -- reactor mode does not auto-call it the way a command module's
        -- generated main-stub would (see wasm/spike/init_shim.c's own
        -- note, confirmed empirically getting Phase 0's spike working).
        ghc-options: -no-hs-main
                     -optl-mexec-model=reactor
                     -optl-Wl,--export=trellisSetup,--export=trellisTick
        c-sources: wasm/init_shim.c
        build-depends: ghc-experimental
    else
        ghc-options: -rtsopts
        -- --gc-sections is a GNU-linker flag; Apple's linker rejects it
        -- outright and fails the whole link, so Darwin gets its own
        -- dead-code-stripping flag instead. [^3]
        if os(osx)
            ghc-options: -optl-Wl,-dead_strip
        else
            ghc-options: -optl-Wl,--gc-sections

    -- SheetState/Render/Update/Formula/Parser/Keymap/Live/Cli are the
    -- spreadsheet app itself, built on the library's reusable machinery
    -- but not reusable machinery themselves - so unlike src/Trellis, they
    -- live here.
    other-modules:    SheetState, SheetState.Geometry, SheetState.Fill,
                      SheetState.Chart,
                      Render, Render.Theme, Render.Editor, Render.Grid,
                      Render.Chart, Render.Help,
                      Update, Update.Events, Update.Buffer, Update.Navigation,
                      Update.Subscriptions, Update.Fill, Update.Chart,
                      Update.Core,
                      Formula, Formula.Builtins, Parser, Keymap, Live, Live.In,
                      Live.Out, Cli, SheetFile

    build-depends:    base,
                      adjunctions,
                      attoparsec,
                      containers,
                      directory,
                      filepath,
                      monadIO,
                      text,
                      time,
                      trellis

    -- process spawns real OS processes for native's Live.In
    -- (ShellInterval) - meaningless in a browser sandbox, and not
    -- something wasm32-wasi needs to build at all, since the wasi
    -- Live.In never imports it.
    if !os(wasi)
        build-depends: process

test-suite trellis-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    default-language: Haskell2010

    -- Reaches into app/ directly since SheetState/Formula/Parser/Update/
    -- Keymap/Live/Cli aren't exposed library modules. Named Spec.hs, not
    -- Main.hs, to avoid colliding with app-native/Main.hs on this shared
    -- source-dir path. [^2] Always native (app-native, not the os(wasi)
    -- swap the executable/library use) - this component only ever builds
    -- for the native target, so it needs Live.In/Live.Out's real
    -- (process-backed) implementation regardless of what os() the rest
    -- of the project happens to be configuring for.
    hs-source-dirs:   test, app, app-native
    other-modules:    SheetStateSpec, FormulaSpec, UpdateSpec, LiveSpec, CliSpec,
                      SheetFileSpec, KeymapSpec,
                      SheetState, SheetState.Geometry, SheetState.Fill,
                      SheetState.Chart,
                      Formula, Formula.Builtins, Parser, Keymap, Live, Live.In,
                      Live.Out, Cli, SheetFile,
                      Update, Update.Events, Update.Buffer, Update.Navigation,
                      Update.Subscriptions, Update.Fill, Update.Chart,
                      Update.Core

    build-depends:    base,
                      adjunctions,
                      attoparsec,
                      comonad,
                      containers,
                      directory,
                      filepath,
                      monadIO,
                      process,
                      text,
                      time,
                      trellis,
                      tasty,
                      tasty-hunit,
                      tasty-quickcheck,
                      QuickCheck

-- [^1]:
-- Peano/Lists/Nested/Sheet are the source of truth for the Sheets
-- machinery, vendored verbatim from an earlier project. CPS/Tubes/UI are
-- that project's terminal activity loop, vendored so Trellis can grow its
-- own interactive front end the same way. Day is exactly the tool for
-- composing differently-typed sibling widgets (e.g. a viewport plus an
-- edit buffer), once that's needed. HIO/Orc build on CPS to let a cell's
-- value come from, or be published to, a cancellable background
-- subscription instead of a pure formula, without touching Sheet's own
-- evaluation.

-- [^2]:
-- SheetState/Formula/Parser/Update/Keymap/Live/Cli aren't exposed
-- library modules (see the executable stanza above), so this is the
-- only way a separate test-suite component can compile against them
-- without either moving them back into the library or adding a third
-- internal-library component just to share code between two
-- components - overkill for a project this size.

-- [^3]:
-- Fixes a real "gcc failed in phase Linker" build failure on macOS
-- (GHC 9.12.2 via ghcup) caused by --gc-sections, a GNU-only flag.
-- -dead_strip is the Darwin linker's equivalent; confirmed working on
-- real macOS hardware.
